{
  "name": "Runner",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "Token rahasia untuk runner"
    },
    "label": {
      "type": "string"
    },
    "last_seen": {
      "type": "string"
    },
    "host": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "token"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}