{
  "name": "Bot",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nama tampilan bot"
    },
    "host": {
      "type": "string",
      "description": "Alamat server Minecraft"
    },
    "port": {
      "type": "number",
      "default": 25565
    },
    "username": {
      "type": "string",
      "description": "Username bot"
    },
    "version": {
      "type": "string",
      "description": "Versi Minecraft, kosongkan untuk otomatis"
    },
    "auth": {
      "type": "string",
      "enum": [
        "offline",
        "microsoft"
      ],
      "enumColors": [
        "gray",
        "blue"
      ],
      "default": "offline"
    },
    "desired_state": {
      "type": "string",
      "enum": [
        "running",
        "stopped"
      ],
      "enumColors": [
        "green",
        "gray"
      ],
      "default": "stopped"
    },
    "status": {
      "type": "string",
      "enum": [
        "offline",
        "connecting",
        "online",
        "error"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green",
        "red"
      ],
      "default": "offline"
    },
    "status_message": {
      "type": "string"
    },
    "last_seen": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "host",
    "username"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}