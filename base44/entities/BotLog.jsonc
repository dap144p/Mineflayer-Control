{
  "name": "BotLog",
  "type": "object",
  "properties": {
    "bot_id": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "info",
        "chat",
        "error",
        "system"
      ],
      "enumColors": [
        "gray",
        "blue",
        "red",
        "purple"
      ],
      "default": "info"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "bot_id",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}