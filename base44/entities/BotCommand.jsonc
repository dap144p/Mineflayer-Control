{
  "name": "BotCommand",
  "type": "object",
  "properties": {
    "bot_id": {
      "type": "string"
    },
    "bot_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "chat",
        "command",
        "move",
        "jump",
        "look",
        "stop"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray",
        "gray",
        "gray",
        "gray"
      ]
    },
    "payload": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "done",
        "error"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green",
        "red"
      ],
      "default": "pending"
    },
    "result": {
      "type": "string"
    }
  },
  "required": [
    "bot_id",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}