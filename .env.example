# Pterodactyl usually provides SERVER_PORT automatically.
# PORT can override it.
PORT=
SERVER_PORT=
HOST=0.0.0.0

# Persistent data location inside the Pterodactyl server volume.
DATA_DIR=./data

# Maximum bots connected at the same time.
MAX_BOTS=10

# Set true when HTTPS is terminated by a reverse proxy in front of this app.
COOKIE_SECURE=false
